<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>AuthService.Infrastructure</RootNamespace>
		<AssemblyName>AuthService.Infrastructure</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
	  <ProjectReference Include="..\AuthService.Application\AuthService.Application.csproj" />
	  <ProjectReference Include="..\AuthService.Domain\AuthService.Domain.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="GrpcClients\" />
	  <Folder Include="Messaging\" />
	  <Folder Include="Persistence\" />
	  <Folder Include="Repositories\" />
	  <Folder Include="Services\" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Google.Protobuf" Version="3.34.1" />
	  <PackageReference Include="Grpc.Net.ClientFactory" Version="2.80.0" />
	  <PackageReference Include="Grpc.Tools" Version="2.80.0">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	</ItemGroup>

</Project>
