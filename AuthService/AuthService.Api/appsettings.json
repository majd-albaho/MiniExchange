{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=MiniExchangeAuth;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Formatting.Compact",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread",
      "Serilog.Enrichers.Span"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithSpan"
    ],
    "Properties": {
      "ServiceName": "auth-service",
      "Application": "auth-service",
      "Environment": "Development"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "RabbitMQ": {
    "Host": "localhost"
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "_34wo?Q?55tM:1oVQ@VBw8Z{X]g[>+;=",
    "Issuer": "MiniExchange.AuthService",
    "Audience": "MiniExchange.Clients",
    "AccessTokenExpiryMinutes": "60",
    "RefreshTokenExpiryDays": "1"
  }
}
