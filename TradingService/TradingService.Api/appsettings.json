{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=MiniExchangeTrading;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "RabbitMQ": {
    "Host": "localhost"
  },
  "MatchingEngineService": {
    "GrpcAddress": "http://localhost:5210"
  },
  "TradingPairService": {
    "GrpcAddress": "http://localhost:5208"
  },
  "WalletService": {
    "GrpcAddress": "http://localhost:5206"
  },
  "MarketDataService": {
    "BaseUrl": "http://localhost:5205"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Formatting.Compact",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread",
      "Serilog.Enrichers.Span"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithSpan"
    ],
    "Properties": {
      "ServiceName": "trading-service",
      "Application": "trading-service",
      "Environment": "Development"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
