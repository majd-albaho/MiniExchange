<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>MatchingEngineService.Api</RootNamespace>
		<AssemblyName>MatchingEngineService.Api</AssemblyName>
		<UserSecretsId>836f3e46-84b7-4711-95f5-6509324dcc55</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore" Version="2.80.0" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="Protos\trading_pair.proto" GrpcServices="Server" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Controllers\" />
		<Folder Include="Extensions\" />
		<Folder Include="Middlewares\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MatchingEngineService.Application\MatchingEngineService.Application.csproj" />
		<ProjectReference Include="..\MatchingEngineService.Infrastructure\MatchingEngineService.Infrastructure.csproj" />
	</ItemGroup>

</Project>
