{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "-f", "FrontEndApp/docker-compose.yml", "up"],
      "port": 4200
    },
    {
      "name": "frontend-npm",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start", "--prefix", "FrontEndApp"],
      "port": 4200
    },
    {
      "name": "market-data-service",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "MarketDataService/MarketDataService.Api", "--urls", "http://localhost:5205"],
      "port": 5205
    }
  ]
}
